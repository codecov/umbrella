# syntax=docker/dockerfile:1.4
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.30-bookworm-slim@sha256:22334efe746f1b69217d455049b484d7b8cacfb2d5f42555580b62415a98e0a3
ARG PYTHON_IMAGE=python:3.13.17-slim-bookworm@sha256:e32be0e55814a08977501ca863271d9bd02443710db8f2afaf8372e2c4508530

FROM $UV_IMAGE AS uv

# BUILD STAGE
FROM $PYTHON_IMAGE as build
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Install all system packages needed by either worker OR codecov-api
COPY docker/apt-archive-keys.py /tmp/apt-archive-keys.py
RUN python /tmp/apt-archive-keys.py && rm /tmp/apt-archive-keys.py
RUN apt-get update
RUN apt-get install -y \
    build-essential \
    libffi-dev \
    libpq-dev \
    libxml2-dev \
    libxslt-dev \
    git \
    curl

# Install the Rust toolchain which we need to build test-results-parser
ARG RUST_VERSION=stable
ENV RUST_VERSION=${RUST_VERSION}
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | bash -s -- -y --profile minimal --default-toolchain $RUST_VERSION
ENV PATH="/root/.cargo/bin:$PATH"

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=python \
    UV_PROJECT_ENVIRONMENT=/app

# Export a requirements.txt
# See pyproject.toml's default-groups attribute for contents
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=./pyproject.toml,target=./pyproject.toml \
    --mount=type=bind,source=./uv.lock,target=./uv.lock \
    --mount=type=bind,source=libs/shared,target=libs/shared \
    uv export --no-group dev --no-hashes --frozen --format requirements-txt > requirements.txt

# The resulting requirements.txt includes ourselves as a dependency we should install
# "editably". Filter that out, leaving only external dependencies.
RUN grep -v '^-e ' requirements.txt > requirements.remote.txt

# Fetch/build wheels for all external dependencies.
RUN --mount=type=bind,source=libs/shared,target=libs/shared \
    pip wheel -w /wheels --find-links /wheels -r /requirements.remote.txt

# Build a wheel for ourselves
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=./pyproject.toml,target=./pyproject.toml \
    --mount=type=bind,source=./uv.lock,target=./uv.lock \
    --mount=type=bind,source=libs/shared,target=libs/shared \
    uv build --all-packages --wheel -o /wheels

# RUNTIME STAGE
FROM $PYTHON_IMAGE
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

ARG APP_DIR

# Patch stale OS packages carried by the base image (this is the scanned stage)
# and avoid pulling optional codec recommends (libheif/libde265/tiff) that have
# no Debian fix and are unused at runtime.
# Drop system libexpat1 (CVE-2026-45186, no Bookworm fix): CPython's pyexpat
# embeds its own expat and does not link the shared library.
COPY docker/apt-archive-keys.py /tmp/apt-archive-keys.py
RUN python /tmp/apt-archive-keys.py && rm /tmp/apt-archive-keys.py
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends \
    perl-base=5.36.0-7+deb12u4 \
    libpcre2-8-0 \
    libxml2-dev \
    libxslt-dev \
    libpq-dev \
    make \
    && apt-get purge -y libexpat1 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Bookworm publishes no sqlite3 >= 3.54.0, and sid's 3.54.1 needs libc6 >= 2.38.
# Replace libsqlite3-0 so dpkg reports the fixed version the scan compares.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && python - <<'PY'
import hashlib, tarfile, urllib.request
url = "https://www.sqlite.org/2026/sqlite-autoconf-3540100.tar.gz"
path = "/tmp/sqlite.tar.gz"
urllib.request.urlretrieve(url, path)
digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
expect = "926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e"
if digest != expect:
    raise SystemExit(f"sqlite tarball sha256 {digest}")
tarfile.open(path).extractall("/tmp")
PY
    && cd /tmp/sqlite-autoconf-3540100 \
    && export CFLAGS="-O2 -fno-strict-aliasing \
        -DSQLITE_SECURE_DELETE -DSQLITE_ENABLE_COLUMN_METADATA \
        -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS \
        -DSQLITE_ENABLE_RTREE -DSQLITE_SOUNDEX=1 \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY \
        -DSQLITE_ENABLE_DBSTAT_VTAB -DSQLITE_ENABLE_DBPAGE_VTAB \
        -DSQLITE_ALLOW_ROWID_IN_VIEW -DSQLITE_ENABLE_UPDATE_DELETE_LIMIT=1 \
        -DSQLITE_ENABLE_LOAD_EXTENSION -DSQLITE_ENABLE_JSON1 \
        -DSQLITE_LIKE_DOESNT_MATCH_BLOBS -DSQLITE_THREADSAFE=1 \
        -DSQLITE_USE_URI=1 -DSQLITE_MAX_SCHEMA_RETRY=25 \
        -DSQLITE_ENABLE_PREUPDATE_HOOK -DSQLITE_ENABLE_SESSION \
        -DSQLITE_ENABLE_STMTVTAB -DSQLITE_STRICT_SUBTYPE=1 \
        -DSQLITE_MAX_VARIABLE_NUMBER=250000" \
    && libdir=/usr/lib/$(gcc -dumpmachine) \
    && ./configure --prefix=/usr --libdir="$libdir" --disable-static --enable-threadsafe \
    && make -j"$(nproc)" \
    && make install DESTDIR=/tmp/sqlite-root \
    && rm -rf /tmp/debpkg \
    && mkdir -p "/tmp/debpkg/DEBIAN" "/tmp/debpkg${libdir}" \
    && cp -a /tmp/sqlite-root${libdir}/libsqlite3.so.* "/tmp/debpkg${libdir}/" \
    && printf '%s\n' \
        'Package: libsqlite3-0' \
        'Source: sqlite3' \
        'Version: 3.54.1-1' \
        "Architecture: $(dpkg --print-architecture)" \
        'Multi-Arch: same' \
        'Maintainer: Codecov <security@codecov.io>' \
        'Depends: libc6 (>= 2.36)' \
        'Description: SQLite 3 shared library' \
        > /tmp/debpkg/DEBIAN/control \
    && dpkg-deb --build /tmp/debpkg /tmp/libsqlite3.deb \
    && dpkg -i /tmp/libsqlite3.deb \
    && ldconfig \
    && python -c 'import sqlite3; assert sqlite3.sqlite_version=="3.54.1", sqlite3.sqlite_version' \
    && apt-get purge -y build-essential \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/sqlite.tar.gz /tmp/sqlite-autoconf-3540100 /tmp/sqlite-root /tmp/debpkg /tmp/libsqlite3.deb

COPY --from=build /wheels/ /wheels/

# pip ships in the Python image, not uv.lock. 26.2.2 vendors certifi 2026.10.19.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=./pyproject.toml,target=./pyproject.toml \
    --mount=type=bind,source=./uv.lock,target=./uv.lock \
    --mount=type=bind,source=libs/shared,target=libs/shared \
    uv pip install --no-deps --no-index --find-links=/wheels /wheels/* --system \
    && uv pip install --system 'pip>=26.2.2'
